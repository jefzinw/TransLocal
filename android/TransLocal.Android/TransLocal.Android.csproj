<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <SupportedOSPlatformVersion>26</SupportedOSPlatformVersion>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>TransLocal.Mobile</RootNamespace>
    <AssemblyName>TransLocal.Mobile</AssemblyName>
    <ApplicationId>com.jefzinw.translocal</ApplicationId>
    <ApplicationVersion>130</ApplicationVersion>
    <ApplicationDisplayVersion>1.3.0</ApplicationDisplayVersion>
    <AndroidPackageFormat>apk</AndroidPackageFormat>
    <RuntimeIdentifiers>android-arm64;android-arm</RuntimeIdentifiers>
    <!-- As mensagens do protocolo usam System.Text.Json por reflexão: não podar o código do app. -->
    <TrimMode>partial</TrimMode>
    <JsonSerializerIsReflectionEnabledByDefault>true</JsonSerializerIsReflectionEnabledByDefault>
    <!-- Código compartilhado com o Windows referencia APIs só do Windows que o celular não usa. -->
    <NoWarn>$(NoWarn);CA1416;CA1422</NoWarn>
  </PropertyGroup>

  <PropertyGroup>
    <AndroidSdkDirectory Condition="'$(AndroidSdkDirectory)' == '' and Exists('$(LOCALAPPDATA)\Android\Sdk')">$(LOCALAPPDATA)\Android\Sdk</AndroidSdkDirectory>
    <JavaSdkDirectory Condition="'$(JavaSdkDirectory)' == '' and Exists('$(LOCALAPPDATA)\Microsoft\jdk-android')">$(LOCALAPPDATA)\Microsoft\jdk-android</JavaSdkDirectory>
  </PropertyGroup>

  <!-- Protocolo e segurança: os MESMOS arquivos do aplicativo Windows. -->
  <ItemGroup>
    <Compile Include="..\..\src\TransLocal\Protocol.cs" Link="Shared\Protocol.cs" />
    <Compile Include="..\..\src\TransLocal\Discovery.cs" Link="Shared\Discovery.cs" />
    <Compile Include="..\..\src\TransLocal\Security\DeviceIdentity.cs" Link="Shared\DeviceIdentity.cs" />
    <Compile Include="..\..\src\TransLocal\Security\SecureChannel.cs" Link="Shared\SecureChannel.cs" />
    <Compile Include="..\..\src\TransLocal\Security\Totp.cs" Link="Shared\Totp.cs" />
    <Compile Include="..\..\src\TransLocal\Streaming\RemoteAccess.cs" Link="Shared\RemoteAccess.cs" />
  </ItemGroup>
</Project>
